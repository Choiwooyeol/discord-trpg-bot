# 새 TRPG 봇 전용 토큰. 기존 봇 토큰을 복사하지 마세요.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_LOBBY_CHANNEL_IDS=
DISCORD_ALERT_CHANNEL_ID=
# openai: 별도 API 과금 / codex: 공식 CLI의 ChatGPT 구독 로그인
AI_PROVIDER=codex
# 공식 Codex CLI 설치 후 별도 계정 로그인 필요. API로 자동 대체하지 않음.
CODEX_BIN=codex
CODEX_HOME=
# 비우면 로그인 계정에서 Codex 기본 모델 사용
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=90
CODEX_DAILY_REQUEST_LIMIT=100
OPENAI_API_KEY=
# 사용 가능한 Responses + Structured Outputs 모델을 직접 지정
OPENAI_MODEL=
OPENAI_DAILY_BUDGET_USD=1
# 선택한 모델의 공식 100만 토큰당 USD 가격. 미설정 시 AI 호출 차단
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
DATABASE_FILE=data/trpg.sqlite
EXPLORATION_WINDOW_SECONDS=45
CONSENSUS_WINDOW_SECONDS=30
COMBAT_TURN_SECONDS=90
MIN_PARTY_SIZE=2
MAX_PARTY_SIZE=6
MAX_ACTIVE_SESSIONS=10
MAX_INPUT_CHARS=1000
BACKUP_RETENTION_DAYS=14
DATA_RETENTION_DAYS=365
